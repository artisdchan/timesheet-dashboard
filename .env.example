# Azure AD / Microsoft Graph API Configuration
# Copy this file to .env and fill in your values

# Azure AD Application (client) ID
# Get this from Azure Portal > App Registrations > Your App > Overview
VITE_AZURE_CLIENT_ID=your-client-id-here

# Azure AD Tenant ID
# Use "common" for multi-tenant apps (any organization)
# Use your specific tenant ID for single-tenant apps
# Get this from Azure Portal > App Registrations > Your App > Overview > Directory (tenant) ID
VITE_AZURE_TENANT_ID=common

# ============================================
# Supabase Configuration (Git Integration)
# ============================================

# Supabase Project URL
# Get this from Supabase Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key
# Get this from Supabase Dashboard > Project Settings > API > Project API keys > anon public
VITE_SUPABASE_ANON_KEY=your-anon-key-here
